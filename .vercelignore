# Vercel ignore file
# Files and directories to ignore during Vercel deployment

# Environment files
.env
.env.local
.env.development
.env.test
.env.production
.env.example

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
.next/
out/
build/
dist/

# Cache
.turbo/
.cache/
.parcel-cache/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing
coverage/
.nyc_output/
.jest/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Local development
.vercel/

# Husky
.husky/_/

# TypeScript build info
*.tsbuildinfo

# Documentation (if you don't want to deploy docs)
docs/
documentation/

# Scripts that aren't needed in production
scripts/
*.sh
